# Open Brain — local Docker stack
# Copy to .env and fill in values before running docker-compose.local.yml

# MCP server auth key — clients must supply this to call any tool
MCP_ACCESS_KEY=change-me-random-secret

# OpenRouter API key (used for embeddings and metadata extraction)
OPENROUTER_API_KEY=

# Optional overrides
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# PostgreSQL credentials (used by both the postgres container and MCP server)
POSTGRES_DB=openbrain
POSTGRES_USER=openbrain
POSTGRES_PASSWORD=change-me-strong-password

# Cloudflare Tunnel token — create a tunnel at dash.cloudflare.com/zero-trust/networks/tunnels
# Point the tunnel's public hostname to http://open-brain-mcp:8000
# Then paste the token shown during tunnel creation here.
CLOUDFLARE_TUNNEL_TOKEN=
